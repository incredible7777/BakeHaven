# ========================================================
# BakeHaven Backend Environment Variables (Production Template)
# ========================================================

# Server Port (Render / Railway set this automatically, defaults to 5000)
PORT=5000

# Environment mode ('production' on cloud hosts)
NODE_ENV=production

# Client URL (Your live Vercel frontend URL, NO trailing slash)
CLIENT_URL=https://your-bakehaven-frontend.vercel.app

# MongoDB Atlas Connection String (From https://cloud.mongodb.com)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# JWT Authentication Secrets (Generate secure random 32+ character strings)
ACCESS_TOKEN_SECRET=your_super_secret_access_token_key_here_random_string_2026!
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key_here_random_string_2026!
REFRESH_TOKEN_EXPIRY=10d

# Razorpay API Credentials (From https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
